<?xml version="1.0" encoding="utf-8"?>
<packages>
  <package id="NUnit" version="3.6.1" targetFramework="net45" />
  <!-- The runner, pinned to the same version as the framework. Without it the tests
       compile but nothing can execute them, which is how a test project quietly rots. -->
  <package id="NUnit.ConsoleRunner" version="3.6.1" targetFramework="net45" />
</packages>
